# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，切勿提交）
#   cp .env.example .env

# ===== 必填 =====
# 你的 API Key（DeepSeek 可在 https://platform.deepseek.com 创建）
# 换其他模型时，这里填对应提供商的 key
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 以下可选，不填时使用内置默认值 =====
# 模型提供商：deepseek / openai / google_genai / anthropic 等（见 README「更换模型」）
# LLM_PROVIDER=deepseek
# 模型名（provider 专属，不能跨提供商混用）：
# LLM_MODEL_FLASH=deepseek-v4-flash
# LLM_MODEL_PRO=deepseek-v4-pro
# 自定义网关/代理地址：OpenAI 兼容端点（如豆包/火山引擎）需要填
# LLM_BASE_URL=
# 数据存储与日志路径
# DB_PATH=deskpal.db
# LOG_FILE=deskpal.log
# LOG_LEVEL=INFO
